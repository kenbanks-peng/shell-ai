---
import { shellGuides } from "../data/shells";
---

<div class="shell-tabs" data-shell-tabs>
  <div class="tab-list" role="tablist" aria-label="Shell integration">
    {shellGuides.map((shell, index) => (
      <button
        id={`tab-${shell.id}`}
        type="button"
        role="tab"
        aria-controls={`panel-${shell.id}`}
        aria-selected={index === 0 ? "true" : "false"}
        tabindex={index === 0 ? "0" : "-1"}
      >
        {shell.name}
      </button>
    ))}
  </div>
  {shellGuides.map((shell, index) => (
    <article
      id={`panel-${shell.id}`}
      class="shell-panel"
      role="tabpanel"
      aria-labelledby={`tab-${shell.id}`}
      hidden={index !== 0}
    >
      <div>
        <p class="eyebrow">{shell.name} · {shell.configFile}</p>
        <h3>{shell.name}</h3>
        <p class="shell-copy">{shell.description}</p>
        <p class="small-note">At an empty prompt, press <kbd>?</kbd> to ask. Press <kbd>!</kbd> for prompt history or <kbd>/</kbd> for the menu.</p>
      </div>
      <div class="tab-code">
        <span>Add to {shell.configFile}</span>
        <code>{shell.initCommand}</code>
        <span>Example suggestion</span>
        <code>{shell.example}</code>
      </div>
    </article>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-shell-tabs]").forEach((tabs) => {
    const tabButtons = Array.from(tabs.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(tabs.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    const selectTab = (tab: HTMLButtonElement) => {
      const selectedIndex = tabButtons.indexOf(tab);
      tabButtons.forEach((button, index) => {
        const selected = index === selectedIndex;
        button.setAttribute("aria-selected", String(selected));
        button.tabIndex = selected ? 0 : -1;
        panels[index].hidden = !selected;
      });
    };

    tabButtons.forEach((tab, index) => {
      tab.addEventListener("click", () => selectTab(tab));
      tab.addEventListener("keydown", (event) => {
        const keys = ["ArrowLeft", "ArrowRight", "Home", "End"];
        if (!keys.includes(event.key)) return;
        event.preventDefault();
        const nextIndex = event.key === "Home" ? 0 : event.key === "End" ? tabButtons.length - 1 : (index + (event.key === "ArrowRight" ? 1 : -1) + tabButtons.length) % tabButtons.length;
        tabButtons[nextIndex].focus();
        selectTab(tabButtons[nextIndex]);
      });
    });
  });
</script>
