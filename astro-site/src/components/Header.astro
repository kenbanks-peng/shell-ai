---
const basePath = import.meta.env.BASE_URL;
const navigation = [
  { label: "How it works", href: `${basePath}#how-it-works` },
  { label: "Shells", href: `${basePath}#shells` },
  { label: "Install", href: `${basePath}#install` },
  { label: "Integrations", href: `${basePath}integrations/` },
  { label: "Configuration", href: `${basePath}#configuration` },
];
---

<header>
  <nav class="shell" aria-label="Main navigation">
    <a class="brand" href={`${basePath}#top`} aria-label="shell-ai home">
      <span class="mark" aria-hidden="true">$_</span>shell-ai
    </a>
    <div class="nav-links">
      {navigation.map(({ label, href }) => <a href={href}>{label}</a>)}
      <a href="https://github.com/kenbanks-peng/shell-ai">GitHub ↗</a>
    </div>
  </nav>
</header>
